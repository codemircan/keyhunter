{
  "manifest_version": 3,
  "name": "KeyHunter: Professional Secret Scanner",
  "version": "1.0",
  "description": "JS dosyalarındaki API anahtarlarını ve gizli tokenları avlar.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "patterns.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
